    BLOCK "040404B0"
    BEGIN
      VALUE "FileDescription", "Hanin Revival TSF front-end"
      VALUE "ProductName", "Hanin Revival"
      VALUE "FileVersion", "0.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
