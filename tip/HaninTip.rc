IDI_HANIN ICON "hanin_fallback.ico"
IDI_MODE_ZH ICON "mode_zh.ico"
IDI_MODE_EN ICON "mode_en.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
